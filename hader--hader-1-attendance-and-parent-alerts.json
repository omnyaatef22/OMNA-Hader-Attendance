      "id": "n136",
      "name": "Attendance Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reject impossible submissions before touching the sheet.\nconst g = (k, l) => String($json[k] ?? $json[l] ?? '').trim();\nconst ids = s => [...new Set(s.toUpperCase().match(/S\\d{3}/g) || [])];\nconst sub = { class: g('class', 'Class'), period: g('period', 'Period'), date: g('date', 'Date').slice(0, 10), teacher: g('teacher', 'Teacher name'),\n  absent: ids(g('absent', 'Absent student IDs')), late: ids(g('late', 'Late student IDs')) };\nconst p = [];\nconst d = DateTime.fromISO(sub.date, { zone: 'Africa/Cairo' }); const today = $now.setZone('Africa/Cairo').startOf('day');\nif (!d.isValid) p.push('date is invalid');\nelse { if (d > today) p.push('date is in the future'); if (today.diff(d, 'days').days > 2) p.push('more than 2 days late: ask the admin to correct it');\n  if ([5, 6].includes(d.weekday)) p.push(d.toFormat('cccc') + ' is not a school day'); }\nconst both = sub.absent.filter(x => sub.late.includes(x)); if (both.length) p.push('listed as both absent and late: ' + both.join(', '));\nconst typed = (g('absent', 'Absent student IDs') + ' ' + g('late', 'Late student IDs')).replace(/S\\d{3}|[\\s,،;]/gi, ''); if (typed) p.push('unrecognised text in the ID lists: \"' + typed.slice(0, 40) + '\"');\nreturn [{ json: { ...sub, problems: p, ok: !p.length } }];"
      },
