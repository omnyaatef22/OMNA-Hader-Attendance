    {
      "parameters": {
        "jsCode": "// One record per student in the class. IDs that are not in this class stop the submission.\nconst s = $('Validate Submission').first().json; const kids = $input.all().map(i => i.json).filter(k => k.student_id);\nconst known = new Set(kids.map(k => k.student_id));\nconst unknown = [...s.absent, ...s.late].filter(x => !known.has(x));\nif (unknown.length) return [{ json: { ok: false, problems: ['not in ' + s.class + ': ' + unknown.join(', ')] } }];\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nreturn kids.map(k => ({ json: { ok: true, record_id: s.date.replace(/-/g, '') + '-' + s.class + '-P' + s.period + '-' + k.student_id, date: s.date, class: s.class, period: s.period,\n  student_id: k.student_id, name: k.name, parent_name: k.parent_name, parent_phone: k.parent_phone,\n  status: s.absent.includes(k.student_id) ? 'absent' : s.late.includes(k.student_id) ? 'late' : 'present', submitted_by: s.teacher, submitted_at: now } }));"
      },
