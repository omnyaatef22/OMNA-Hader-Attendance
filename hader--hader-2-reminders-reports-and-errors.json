    {
      "parameters": {
        "jsCode": "// Attendance rate per class for the last 7 days, as an HTML table.\nconst from = $now.setZone('Africa/Cairo').minus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(r => r.student_id && r.date >= from);\nconst by = {};\nfor (const r of rows) { const c = (by[r.class] = by[r.class] || { total: 0, present: 0, late: 0, absent: 0 }); c.total++; c[r.status] = (c[r.status] || 0) + 1; }\nconst tr = Object.entries(by).map(([k, c]) => '<tr><td>' + k + '</td><td>' + c.total + '</td><td>' + c.present + '</td><td>' + c.late + '</td><td>' + c.absent + '</td><td>' + Math.round(100 * (c.present + c.late) / c.total) + '%</td></tr>').join('');\nreturn [{ json: { html: '<h3>Weekly attendance since ' + from + '</h3><table border=\"1\" cellpadding=\"6\"><tr><th>Class</th><th>Records</th><th>Present</th><th>Late</th><th>Absent</th><th>Rate</th></tr>' + (tr || '<tr><td colspan=\"6\">No records this week</td></tr>') + '</table>' } }];"
      },
