    {
      "parameters": {
        "jsCode": "// A student absent on each of the last 3 school days that have records = a streak. Counselor follows up.\nconst att = $('Read All Attendance').all().map(i => i.json).filter(r => r.student_id);\nconst days = [...new Set(att.map(r => r.date))].sort().slice(-3);\nif (days.length < 3) return [];\nconst students = Object.fromEntries($input.all().map(i => [i.json.student_id, i.json]));\nconst out = [];\nfor (const id of Object.keys(students)) {\n  const absentAll = days.every(d => att.some(r => r.student_id === id && r.date === d && r.status === 'absent'));\n  if (absentAll) out.push(students[id]);\n}\nif (!out.length) return [];\nreturn [{ json: { count: out.length, html: '<p>Students absent on ' + days.join(', ') + ':</p><ul>' + out.map(s => '<li>' + s.student_id + ' · ' + s.name + ' (' + s.class + ') · parent ' + s.parent_name + ' ' + s.parent_phone + '</li>').join('') + '</ul>' } }];"
      },
      "id": "n130",
      "name": "Find Absence Streaks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        550
      ]
