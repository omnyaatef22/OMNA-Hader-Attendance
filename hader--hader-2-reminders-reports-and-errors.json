    {
      "parameters": {
        "jsCode": "// Every class+period on today's timetable must have attendance by 10:00. List the gaps.\nconst day = $now.setZone('Africa/Cairo').toFormat('cccc');\nconst done = new Set($input.all().map(i => i.json).filter(r => r.class).map(r => r.class + '|' + r.period));\nreturn $('Read Timetable').all().map(i => i.json).filter(t => t.day === day && !done.has(t.class + '|' + t.period))\n  .map(t => ({ json: { chat: t.teacher_chat_id || 'PUT_ADMIN_CHAT_ID', text: '⏰ Attendance missing: ' + t.class + ' period ' + t.period + ' (' + t.subject + ', ' + t.teacher_name + '). Submit: PUT_N8N_URL/form/hader-attendance' } }));"
      },
